#%RAML 1.0
title: API Contraventions
version: v1
baseUri: http://127.0.0.1:5000
mediaType: application/json

documentation:
  - title: API
    content: |
      Service REST permettant d'obtenir la liste des contraventions
      entre deux dates et les details d'un établissement.

types:
  Violation:
    type: object
    properties:
      id_poursuite: integer
      business_id: integer
      date_violation: string
      description: string
      adresse: string
      date_jugement: string
      etablissement: string
      montant: number
      proprietaire: string
      ville: string
      statut: string
      date_statut: string
      categorie: string

  EtablissementDetails:
    type: object
    properties:
      nom: string
      business_id: integer
      adresse: string
      nombre_violations: integer
      violations: Violation[]
      proprietaire: string | nil
      ville: string | nil
      categorie: string | nil
      montantTotal: number

/contrevenants:
  get:
    description: Retourne la liste des contraventions entre deux dates.
    queryParameters:
      du:
        type: date-only
        required: true
        example: 2022-05-08
      au:
        type: date-only
        required: true
        example: 2024-05-15
    responses:
      200:
        body:
          application/json:
            type: Violation[]
      400:
        body:
          application/json:
            example:
              { "error": "Les dates doivent etre au format ISO 8601 YYYY-MM-DD." }

/etablissement/{business_id}:
  get:
    description: Retourne les details d'un établissement.
    uriParameters:
      business_id:
        type: integer
        required: true
        example: 123456
    responses:
      200:
        body:
          application/json:
            type: EtablissementDetails
      404:
        body:
          application/json:
            example:
              { "error": "Établissement non trouvé." }
