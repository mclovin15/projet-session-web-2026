#%RAML 1.0
title: API Projet Session 
version: v1
baseUri: http://127.0.0.1:5000
mediaType: application/json

documentation:
  - title: API
    content: |
      Service REST permettant d'obtenir la liste des contraventions
      entre deux dates, les details d'un établissement et le nombre
      de violations par établissement, ainsi que de creer et supprimer
      une demande d'inspection, gerer l'authentification et modifier
      certaines informations d'un utilisateur.

types:
  Violation:
    type: object
    properties:
      id_poursuite: integer
      business_id: integer
      date_violation: string
      description: string
      adresse: string
      date_jugement: string
      etablissement: string
      montant: number
      proprietaire: string
      ville: string
      statut: string
      date_statut: string
      categorie: string

  EtablissementDetails:
    type: object
    properties:
      nom: string
      business_id: integer
      adresse: string
      nombre_violations: integer
      violations: Violation[]
      proprietaire: string | nil
      ville: string | nil
      categorie: string | nil
      montantTotal: number

  EtablissementViolationCount:
    type: object
    properties:
      business_id: integer
      etablissement: string
      adresse: string
      nombre_violations: integer

  DemandeInspection:
    type: object
    properties:
      business_id: integer
      etablissement: string
      adresse: string
      ville: string
      date_visite: string
      nom_complet_client: string
      description_prob: string
    example:
      {
        "business_id": 12345,
        "etablissement": "Restaurant ABC",
        "adresse": "123 Rue Test",
        "ville": "Montreal",
        "date_visite": "2026-03-27",
        "nom_complet_client": "Jean Tremblay",
        "description_prob": "Presence d'insectes et surfaces sales."
      }

  EtablissementSurveille:
    type: object
    properties:
      business_id: integer
      etablissement: string
      adresse: string
    example:
      {
        "business_id": 12345,
        "etablissement": "Restaurant ABC",
        "adresse": "123 Rue Test"
      }

  UserCreation:
    type: object
    properties:
      nom: string
      prenom: string
      email: string
      avatar?: string
      password: string
      liste_etablissements_surveiller: EtablissementSurveille[]
    example:
      {
        "nom": "Desjardins",
        "prenom": "Yoan",
        "email": "yoan@example.com",
        "avatar": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAUA",
        "password": "MonMotDePasse123!",
        "liste_etablissements_surveiller": [
          {
            "business_id": 12345,
            "etablissement": "Restaurant ABC",
            "adresse": "123 Rue Test"
          },
          {
            "business_id": 67890,
            "etablissement": "Cafe XYZ",
            "adresse": "456 Avenue Exemple"
          }
        ]
      }

  UserLogin:
    type: object
    properties:
      email: string
      password: string
    example:
      {
        "email": "yoan@example.com",
        "password": "MonMotDePasse123!"
      }

  UserProfileUpdate:
    type: object
    properties:
      nom: string
      prenom: string
      avatar?: string
    example:
      {
        "nom": "Desjardins",
        "prenom": "Yoan",
        "avatar": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAUA"
      }

  LoginSuccessResponse:
    type: object
    properties:
      success: boolean
      message: string
      session_id: string
    example:
      {
        "success": true,
        "message": "Connexion réussie.",
        "session_id": "7a1c9f25d5d2405799f0a2601ab23456"
      }

  SuccessResponse:
    type: object
    properties:
      success: boolean
      message: string
    example:
      {
        "success": true,
        "message": "Operation effectuee avec succes."
      }

  ErrorResponse:
    type: object
    properties:
      error: string
    example:
      { "error": "Une erreur est survenue." }

  ValidationErrorResponse:
    type: object
    properties:
      error: string
      errors: string[]
    example:
      {
        "error": "JSON validation error",
        "errors": [
          "'description_prob' is a required property"
        ]
      }

  WatchListUpdateResponse:
    type: object
    properties:
      success: boolean
      message: string
      added_ids: integer[]
      removed_ids: integer[]
      updated_ids: integer[]
    example:
      {
        "success": true,
        "message": "La liste de surveillance a été modifiée avec succès.",
        "added_ids": [12345],
        "removed_ids": [67890],
        "updated_ids": []
      }

/contrevenants:
  get:
    description: Retourne la liste des contraventions entre deux dates.
    queryParameters:
      du:
        type: date-only
        required: true
        example: 2022-05-08
      au:
        type: date-only
        required: true
        example: 2024-05-15
    responses:
      200:
        body:
          application/json:
            type: Violation[]
      400:
        body:
          application/json:
            example:
              { "error": "Les dates doivent etre au format ISO 8601 YYYY-MM-DD." }

/etablissement/{business_id}:
  get:
    description: Retourne les details d'un établissement.
    uriParameters:
      business_id:
        type: integer
        required: true
        example: 123456
    responses:
      200:
        body:
          application/json:
            type: EtablissementDetails
      404:
        body:
          application/json:
            example:
              { "error": "Établissement non trouvé." }

/login:
  post:
    description: Connecte un utilisateur et crée une session active.
    body:
      application/json:
        type: UserLogin
    responses:
      200:
        body:
          application/json:
            type: LoginSuccessResponse
      400:
        body:
          application/json:
            type: ValidationErrorResponse
      403:
        body:
          application/json:
            type: ErrorResponse
      404:
        body:
          application/json:
            type: ErrorResponse

/logout:
  delete:
    description: Déconnecte l'utilisateur actuellement connecté et détruit sa session.
    responses:
      200:
        body:
          application/json:
            type: SuccessResponse
      404:
        body:
          application/json:
            type: ErrorResponse

/violations_par_etablissement:
  get:
    description: Retourne la liste des établissements avec leur nombre de violations.
    responses:
      200:
        body:
          application/json:
            type: EtablissementViolationCount[]
      
/violations_par_etablissement.xml:
  get:
    description: Retourne la liste des etablissements avec leur nombre de violations en format XML.
    responses:
      200:
        body:
          application/xml:
            example: |
              <?xml version="1.0" encoding="utf-8"?>
              <etablissements>
                <etablissement>
                  <business_id>123</business_id>
                  <nom>Restaurant ABC</nom>
                  <adresse>123 Rue Test</adresse>
                  <nombre_violations>4</nombre_violations>
                </etablissement>
              </etablissements>

/violations_par_etablissement.csv:
  get:
    description: Retourne la liste des etablissements avec leur nombre de violations en format CSV.
    responses:
      200:
        body:
          text/csv:
            example: |
              business_id,etablissement,adresse,nombre_violations
              123,Restaurant ABC,123 Rue Test,4

/demande-inspection:
  post:
    description: Cree une demande d'inspection a partir d'un document JSON valide.
    body:
      application/json:
        type: DemandeInspection
    responses:
      201:
        body:
          application/json:
            type: SuccessResponse
      400:
        body:
          application/json:
            type: ValidationErrorResponse

/demande-inspection/{id_inspection}:
  delete:
    description: Supprime une demande d'inspection existante a partir de son identifiant.
    uriParameters:
      id_inspection:
        type: integer
        required: true
        example: 42
    responses:
      200:
        body:
          application/json:
            type: SuccessResponse
      400:
        body:
          application/json:
            type: ErrorResponse
      404:
        body:
          application/json:
            type: ErrorResponse

/user:
  post:
    description: Cree un nouvel utilisateur avec mot de passe, avatar et liste des etablissements a surveiller.
    body:
      application/json:
        type: UserCreation
    responses:
      201:
        body:
          application/json:
            type: SuccessResponse
      400:
        body:
          application/json:
            type: ValidationErrorResponse
      404:
        body:
          application/json:
            type: ErrorResponse

/user/{user_id}:
  patch:
    description: Modifie le nom, le prénom et l'avatar d'un utilisateur connecté.
    uriParameters:
      user_id:
        type: integer
        required: true
        example: 12
    body:
      application/json:
        type: UserProfileUpdate
    responses:
      200:
        body:
          application/json:
            type: SuccessResponse
      400:
        body:
          application/json:
            type: ValidationErrorResponse
      404:
        body:
          application/json:
            type: ErrorResponse

/user_watch_list/{user_id}:
  patch:
    description: Ajoute, retire ou modifie la liste des établissements surveillés d'un utilisateur connecté.
    uriParameters:
      user_id:
        type: integer
        required: true
        example: 12
    body:
      application/json:
        type: object
        properties:
          liste_etablissements_surveiller: EtablissementSurveille[]
        example:
          {
            "liste_etablissements_surveiller": [
              {
                "business_id": 12345,
                "etablissement": "Restaurant ABC",
                "adresse": "123 Rue Test"
              },
              {
                "business_id": 67890,
                "etablissement": "Cafe XYZ",
                "adresse": "456 Avenue Exemple"
              }
            ]
          }
    responses:
      200:
        body:
          application/json:
            type: WatchListUpdateResponse
      400:
        body:
          application/json:
            type: ValidationErrorResponse
      404:
        body:
          application/json:
            type: ErrorResponse
